{
  "_version": "1.65.0",
  "sap.app": {
    "id": "zadvpaymupd",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.3",
      "toolsId": "ae4977d9-3da2-4388-b27f-422b35577b50"
    },
    "dataSources": {
      "ZUI_OIPAYMENTS_O2_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZUI_OIPAYMENTS_O2_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_OIPAYMENTS_O2_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_OIPAYMENTS_O2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_OIPAYMENTS_O2_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZADVPAYMUPD-Upload": {
          "semanticObject": "ZADVPAYMUPD",
          "action": "Upload",
          "title": "{{ZADVPAYMUPD-Upload.flpTitle}}",
          "subTitle": "{{ZADVPAYMUPD-Upload.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.130.9",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zadvpaymupd.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ],
      "js": [
        {
          "uri": "libs/xlsx.full.min.js"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zadvpaymupd.view",
        "async": true,
        "viewPath": "zadvpaymupd.view"
      },
      "routes": [
        {
          "name": "RouteUpload",
          "pattern": ":?query:",
          "target": [
            "TargetUpload"
          ]
        }
      ],
      "targets": {
        "TargetUpload": {
          "id": "Upload",
          "name": "Upload"
        }
      }
    },
    "rootView": {
      "viewName": "zadvpaymupd.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
